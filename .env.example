# Neon pooled connection: application queries at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"
# Neon direct connection: Prisma production migrations during the build.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"
# Clerk modal sign-in uses these two variables; no custom sign-in routes are needed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OPENAI_API_KEY=
# Optional Chat Completions-compatible models for replies and the separate title call.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TITLE_MODEL=gpt-4o-mini
