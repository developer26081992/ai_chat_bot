{
  "name": "rag-document-chatbot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:env && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "build:local": "prisma generate && next build",
    "check:env": "node scripts/check-env.mjs",
    "samples:generate": "node scripts/generate-samples.mjs",
    "export:usb": "node scripts/export-usb.mjs",
    "deployment:record": "node scripts/record-deployment.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@clerk/nextjs": "^6.36.0",
    "@prisma/client": "6.19.0",
    "ai": "^4.3.19",
    "js-tiktoken": "^1.0.21",
    "next": "^15.5.9",
    "pdf-parse": "1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@next/env": "15.5.28"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.0"
  },
  "engines": {
    "node": "22.x"
  }
}
